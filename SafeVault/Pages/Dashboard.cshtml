@page
@model SafeVault.Pages.DashboardModel
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>SafeVault — Dashboard</title><link rel="icon" href="/favicon.ico" type="image/x-icon"></head>
<body><h1>Your dashboard</h1><p>Signed in as @User.Identity?.Name.</p>
<p><a href="/submit">Add an entry</a></p>
<h2>Your saved entries</h2>
@if (Model.Submissions.Count == 0)
{
    <p>You have not saved any entries yet.</p>
}
else
{
    <table>
        <caption>Entries you added to SafeVault</caption>
        <thead><tr><th scope="col">Username</th><th scope="col">Email</th></tr></thead>
        <tbody>
        @foreach (var entry in Model.Submissions)
        {
            <tr><td>@entry.Username</td><td>@entry.Email</td></tr>
        }
        </tbody>
    </table>
}
@if (User.IsInRole("admin")) { <p><a href="/Admin">Admin Dashboard</a></p> }
<form method="post" action="/Logout" asp-antiforgery="true"><button type="submit">Sign out</button></form>
</body></html>


